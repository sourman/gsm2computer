<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hub stream URL (token endpoint on your computer)"
        android:textSize="12sp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/etStreamTokenUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://your-hub.example/token"
        android:inputType="textUri"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/etStreamModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Model (optional)"
        android:inputType="text"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/etStreamVoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Voice (optional)"
        android:inputType="text"
        android:importantForAutofill="no" />

    <CheckBox
        android:id="@+id/cbAutoconnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Start bridge automatically on boot" />

    <Button
        android:id="@+id/btnLoadConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Load from file" />

</LinearLayout>
