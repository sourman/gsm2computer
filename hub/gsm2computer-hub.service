[Unit]
Description=gsm2computer hub (audio bridge + switchboard)
After=network-online.target tailscaled.service gsm2computer-audio-bus.service pipewire.service
Wants=network-online.target gsm2computer-audio-bus.service

[Service]
Type=simple
WorkingDirectory=%h/gsm2computer-hub
ExecStart=/usr/bin/python3 %h/gsm2computer-hub/hub.py
Environment=GSM2COMPUTER_HUB_HOST=100.101.181.110
Environment=GSM2COMPUTER_HUB_PORT=8787
Environment=GSM2COMPUTER_AUTO_MODE=openclaw
Environment=GSM2COMPUTER_OPENCLAW_TALK=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
