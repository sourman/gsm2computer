[Unit]
Description=gsm2computer OpenClaw Control UI Talk Chromium (WebRTC)
After=pipewire.service gsm2computer-audio-bus.service graphical-session.target
Wants=gsm2computer-audio-bus.service

[Service]
Type=simple
WorkingDirectory=%h/gsm2computer-hub
ExecStart=%h/gsm2computer-hub/start-talk-chromium.sh
Environment=GSM2COMPUTER_TALK_DISPLAY=:1
Environment=DISPLAY=:1
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority
Environment=PULSE_SOURCE=phone_uplink.monitor
Environment=PULSE_SINK=openclaw_bus
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
