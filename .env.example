# Optional hub-token-worker (Cloudflare) — set via `wrangler secret put` in hub-token-worker/
OPENAI_API_KEY=

# Optional hub → Grok Bot webhook (stuck-call abort). Empty URL = no-op.
# Cup: ~/.config/systemd/user/gsm2computer-hub.service.d/alert-webhook.conf
# GSM2COMPUTER_ALERT_WEBHOOK_URL=
# GSM2COMPUTER_ALERT_WEBHOOK_KEY=

# Phone configure script (scripts/configure-bridge.sh)
# HUB_CONTROL_URL=http://hub.mining-ling.ts.net:8787
# STREAM_TOKEN_URL=http://hub.mining-ling.ts.net:8787/token
# STREAM_MODEL=gpt-realtime
# STREAM_VOICE=marin
